void particleFilter_vector_tiling(int * I, int IszX, int IszY, int Nfr, int * seed, int Nparticles){

    int max_size = IszX*IszY*Nfr;
    long long start = get_time();

    //original particle centroid
    double xe = roundDouble(IszY/2.0);
    double ye = roundDouble(IszX/2.0);

    //expected object locations, compared to center
    int radius = 5;
    int diameter = radius*2 - 1;
    int * disk = (int *)malloc(diameter*diameter*sizeof(int));
    strelDisk(disk, radius);
    int countOnes = 0;
    int x, y;
    for(x = 0; x < diameter; x++){
        for(y = 0; y < diameter; y++){
            if(disk[x*diameter + y] == 1)
                countOnes++;
        }
    }

    double * objxy = (double *)malloc(countOnes*2*sizeof(double));
    getneighbors(disk, countOnes, objxy, radius);

    long long get_neighbors = get_time();
    // printf("TIME TO GET NEIGHBORS TOOK: %f\n", elapsed_time(start, get_neighbors));

    //initial weights are all equal (1/Nparticles)
    double * weights = (double *)malloc(sizeof(double)*Nparticles);
    double * likelihood = (double *)malloc(sizeof(double)*Nparticles);
    double * arrayX = (double *)malloc(sizeof(double)*Nparticles);
    double * arrayY = (double *)malloc(sizeof(double)*Nparticles);
    double * xj = (double *)malloc(sizeof(double)*Nparticles);
    double * yj = (double *)malloc(sizeof(double)*Nparticles);
    double * CDF = (double *)malloc(sizeof(double)*Nparticles);
    double * u = (double *)malloc(sizeof(double)*Nparticles);
    int * ind = (int*)malloc(sizeof(int)*countOnes*Nparticles);
    long int * locations = (long int *)malloc(sizeof(long int)*Nparticles);

    // Initialize arrays with vectorized tiling
    unsigned long int gvl = __riscv_vsetvl_e64m1(Nparticles);

    for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
        int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
        int tile_size = tile_end - tile_start;

        gvl = __riscv_vsetvl_e64m1(tile_size);
        _MMR_f64 xWeights = _MM_SET_f64(1.0/((double)(Nparticles)), gvl);
        _MMR_f64 xArrayX = _MM_SET_f64(xe, gvl);
        _MMR_f64 xArrayY = _MM_SET_f64(ye, gvl);

        _MM_STORE_f64(&weights[tile_start], xWeights, gvl);
        _MM_STORE_f64(&arrayX[tile_start], xArrayX, gvl);
        _MM_STORE_f64(&arrayY[tile_start], xArrayY, gvl);
    }

    long long get_weights = get_time();
    // printf("TIME TO GET WEIGHTS TOOK: %f\n", elapsed_time(get_neighbors, get_weights));
    // printf("TIME TO SET ARRAYS TOOK: %f\n", elapsed_time(get_weights, get_time()));

    _MMR_f64 xAux;
    int k;
    int indX, indY;

    for(k = 1; k < Nfr; k++){
        long long set_arrays = get_time();

        // Apply motion model with vectorized tiling
        gvl     = __riscv_vsetvl_e64m1(Nparticles);
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            gvl = __riscv_vsetvl_e64m1(tile_size);

            // Process arrayX
            _MMR_f64 xArrayX = _MM_LOAD_f64(&arrayX[tile_start], gvl);
            xAux = randn_vector(seed, tile_start, gvl);
            xAux = _MM_MUL_f64(xAux, _MM_SET_f64(5.0, gvl), gvl);
            xAux = _MM_ADD_f64(xAux, _MM_SET_f64(1.0, gvl), gvl);
            xArrayX = _MM_ADD_f64(xAux, xArrayX, gvl);
            _MM_STORE_f64(&arrayX[tile_start], xArrayX, gvl);

            // Process arrayY
            _MMR_f64 xArrayY = _MM_LOAD_f64(&arrayY[tile_start], gvl);
            xAux = randn_vector(seed, tile_start, gvl);
            xAux = _MM_MUL_f64(xAux, _MM_SET_f64(2.0, gvl), gvl);
            xAux = _MM_ADD_f64(xAux, _MM_SET_f64(-2.0, gvl), gvl);
            xArrayY = _MM_ADD_f64(xAux, xArrayY, gvl);
            _MM_STORE_f64(&arrayY[tile_start], xArrayY, gvl);
        }

        // long long error = get_time();
        // printf("TIME TO SET ERROR TOOK: %f\n", elapsed_time(set_arrays, error));

        // Particle filter likelihood with tiling
        #pragma omp parallel for
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;

            // Precompute indices for this tile
            for(int x = tile_start; x < tile_end; x++) {
                for(int y = 0; y < countOnes; y++){
                    indX = roundDouble(arrayX[x]) + objxy[y*2 + 1];
                    indY = roundDouble(arrayY[x]) + objxy[y*2];
                    ind[x*countOnes + y] = fabs(indX*IszY*Nfr + indY*Nfr + k);
                    if(ind[x*countOnes + y] >= max_size)
                        ind[x*countOnes + y] = 0;
                }
            }

            // Compute likelihood for this tile
            for(int x = tile_start; x < tile_end; x++) {
                likelihood[x] = 0;
                for(int y = 0; y < countOnes; y++) {
                    likelihood[x] += (pow((I[ind[x*countOnes + y]] - 100),2) -
                                    pow((I[ind[x*countOnes + y]]-228),2))/50.0;
                }
                likelihood[x] = likelihood[x]/((double) countOnes);
            }
        }

        // long long likelihood_time = get_time();
        // printf("TIME TO GET LIKELIHOODS TOOK: %f\n", elapsed_time(error, likelihood_time));

        // Update weights with vectorized tiling
        #pragma omp parallel for private(gvl)
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            gvl = __riscv_vsetvl_e64m1(tile_size);
            _MMR_f64 xWeights = _MM_LOAD_f64(&weights[tile_start], gvl);
            _MMR_f64 xLikelihood = _MM_LOAD_f64(&likelihood[tile_start], gvl);

            // weights[x] = weights[x] * exp(likelihood[x])
            _MMR_f64 xExp = exp_vector(xLikelihood, gvl);
            xWeights = _MM_MUL_f64(xWeights, xExp, gvl);

            _MM_STORE_f64(&weights[tile_start], xWeights, gvl);
        }

        // long long exponential = get_time();
        // printf("TIME TO GET EXP TOOK: %f\n", elapsed_time(likelihood_time, exponential));

        // Sum weights with tiled vector reduction
        double sumWeights = 0;
        #pragma omp parallel for reduction(+:sumWeights) private(gvl)
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            gvl = __riscv_vsetvl_e64m1(tile_size);
            _MMR_f64 xWeights = _MM_LOAD_f64(&weights[tile_start], gvl);

            // Vector reduction for tile sum
            double tile_sum = 0;
            for(int i = 0; i < tile_size; i += gvl) {
                int current_gvl = __riscv_vsetvl_e64m1(tile_size - i);
                _MMR_f64 xChunk = _MM_LOAD_f64(&weights[tile_start + i], current_gvl);
                tile_sum += vector_sum(xChunk, current_gvl);
            }
            sumWeights += tile_sum;
        }

        // long long sum_time = get_time();
        // printf("TIME TO SUM WEIGHTS TOOK: %f\n", elapsed_time(exponential, sum_time));

        // Normalize weights with vectorized tiling
        #pragma omp parallel for private(gvl)
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            gvl = __riscv_vsetvl_e64m1(tile_size);
            _MMR_f64 xWeights = _MM_LOAD_f64(&weights[tile_start], gvl);
            _MMR_f64 xNorm = _MM_SET_f64(sumWeights, gvl);

            xWeights = _MM_DIV_f64(xWeights, xNorm, gvl);
            _MM_STORE_f64(&weights[tile_start], xWeights, gvl);
        }

        // long long normalize = get_time();
        // printf("TIME TO NORMALIZE WEIGHTS TOOK: %f\n", elapsed_time(sum_time, normalize));

        // Estimate object location with tiled vector reduction
        xe = 0;
        ye = 0;
        #pragma omp parallel for reduction(+:xe, ye) private(gvl)
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            double tile_xe = 0, tile_ye = 0;

            // Process in vector chunks within tile
            for(int i = 0; i < tile_size; i += gvl) {
                gvl = __riscv_vsetvl_e64m1(tile_size - i);
                int idx = tile_start + i;

                _MMR_f64 xArrayX = _MM_LOAD_f64(&arrayX[idx], gvl);
                _MMR_f64 xArrayY = _MM_LOAD_f64(&arrayY[idx], gvl);
                _MMR_f64 xWeights = _MM_LOAD_f64(&weights[idx], gvl);

                _MMR_f64 xWeightedX = _MM_MUL_f64(xArrayX, xWeights, gvl);
                _MMR_f64 xWeightedY = _MM_MUL_f64(xArrayY, xWeights, gvl);

                tile_xe += vector_sum(xWeightedX, gvl);
                tile_ye += vector_sum(xWeightedY, gvl);
            }

            xe += tile_xe;
            ye += tile_ye;
        }

        // long long move_time = get_time();
        // printf("TIME TO MOVE OBJECT TOOK: %f\n", elapsed_time(normalize, move_time));
        // printf("XE: %lf\n", xe);
        // printf("YE: %lf\n", ye);
        // double distance = sqrt( pow((double)(xe-(int)roundDouble(IszY/2.0)),2) +
        //                        pow((double)(ye-(int)roundDouble(IszX/2.0)),2) );
        // printf("%lf\n", distance);

        // Resampling - CDF computation with tiling
        CDF[0] = weights[0];
        #pragma omp parallel
        {
            #pragma omp for nowait
            for(int tile_start = 1; tile_start < Nparticles; tile_start += TILE_SIZE) {
                int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
                for(int x = tile_start; x < tile_end; x++){
                    CDF[x] = weights[x] + CDF[x-1];
                }
            }
        }

        long long cum_sum = get_time();
        printf("TIME TO CALC CUM SUM TOOK: %f\n", elapsed_time(move_time, cum_sum));

        double u1 = (1/((double)(Nparticles)))*randu(seed, 0);

        // Compute u values with vectorized tiling
        #pragma omp parallel for private(gvl)
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            gvl = __riscv_vsetvl_e64m1(tile_size);
            _MMR_f64 xU1 = _MM_SET_f64(u1, gvl);
            _MMR_f64 xIndex = _MM_LOAD_i64_as_f64(_MM_SET_i64(0, gvl), gvl); // Initialize index

            // Create index sequence: u1 + x/(Nparticles)
            for(int i = 0; i < tile_size; i += gvl) {
                int current_gvl = __riscv_vsetvl_e64m1(tile_size - i);
                int global_idx = tile_start + i;

                xIndex = _MM_LOAD_i64_as_f64(_MM_SET_i64(global_idx, current_gvl), current_gvl);
                _MMR_f64 xNormalized = _MM_DIV_f64(xIndex, _MM_SET_f64(Nparticles, current_gvl), current_gvl);
                _MMR_f64 xU = _MM_ADD_f64(xU1, xNormalized, current_gvl);

                _MM_STORE_f64(&u[global_idx], xU, current_gvl);
            }
        }

        long long u_time = get_time();
        printf("TIME TO CALC U TOOK: %f\n", elapsed_time(cum_sum, u_time));

        // Resampling with vectorized tiling
        _MMR_MASK_i64 xComp;
        _MMR_MASK_i64 xMask;
        _MMR_f64 xCDF;
        _MMR_f64 xU;
        _MMR_i64 xArray;

        #pragma omp parallel for private(gvl, xComp, xMask, xCDF, xU, xArray)
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            for(int i = tile_start; i < tile_end; i += gvl) {
                gvl = __riscv_vsetvl_e64m1(tile_end - i);
                long int vector_complete = 0;
                xMask = _MM_CAST_i1_i64(_MM_SET_i64(0, gvl));
                xArray = _MM_SET_i64(Nparticles-1, gvl);
                xU = _MM_LOAD_f64(&u[i], gvl);

                for(int j = 0; j < Nparticles; j++){
                    xCDF = _MM_SET_f64(CDF[j], gvl);
                    xComp = _MM_VFGE_f64(xCDF, xU, gvl);
                    xComp = _MM_VMXOR_i64(xComp, xMask, gvl);
                    long int valid = _MM_VMFIRST_i64(xComp, gvl);

                    if(valid != -1) {
                        xArray = _MM_MERGE_i64(xArray, _MM_SET_i64(j, gvl), xComp, gvl);
                        xMask = _MM_VMOR_i64(xComp, xMask, gvl);
                        vector_complete = _MM_VMPOPC_i64(xMask, gvl);
                    }
                    if(vector_complete == gvl) break;
                }
                _MM_STORE_i64(&locations[i], xArray, gvl);
            }
        }

        // Copy resampled particles with tiling
        #pragma omp parallel for
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            for(int j = tile_start; j < tile_end; j++){
                int i = locations[j];
                xj[j] = arrayX[i];
                yj[j] = arrayY[i];
            }
        }

        long long xyj_time = get_time();
        printf("TIME TO CALC NEW ARRAY X AND Y TOOK: %f\n", elapsed_time(u_time, xyj_time));

        // Reset arrays with vectorized tiling
        #pragma omp parallel for private(gvl)
        for(int tile_start = 0; tile_start < Nparticles; tile_start += TILE_SIZE) {
            int tile_end = (tile_start + TILE_SIZE < Nparticles) ? tile_start + TILE_SIZE : Nparticles;
            int tile_size = tile_end - tile_start;

            gvl = __riscv_vsetvl_e64m1(tile_size);
            _MMR_f64 xNewX = _MM_LOAD_f64(&xj[tile_start], gvl);
            _MMR_f64 xNewY = _MM_LOAD_f64(&yj[tile_start], gvl);
            _MMR_f64 xWeights = _MM_SET_f64(1.0/((double)(Nparticles)), gvl);

            _MM_STORE_f64(&arrayX[tile_start], xNewX, gvl);
            _MM_STORE_f64(&arrayY[tile_start], xNewY, gvl);
            _MM_STORE_f64(&weights[tile_start], xWeights, gvl);
        }

        long long reset = get_time();
        printf("TIME TO RESET WEIGHTS TOOK: %f\n", elapsed_time(xyj_time, reset));
    }

    free(locations);
    free(disk);
    free(objxy);
    free(weights);
    free(likelihood);
    free(xj);
    free(yj);
    free(arrayX);
    free(arrayY);
    free(CDF);
    free(u);
    free(ind);
}
